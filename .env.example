# Postgres connection string. The host `database` matches the compose service;
# for host-side tooling (prisma migrate, db studio) use `localhost`.
DATABASE_URL="postgresql://pluma:pluma@localhost:5432/pluma?schema=public"

# Per-service overrides for the dev docker-compose stack (Dockerfile.dev +
# Vite HMR). Compose falls back to these defaults when unset; pinning them
# here keeps host-side tooling in sync. None of these apply to the production
# image (see PORT below for that).
POSTGRES_USER="pluma"
POSTGRES_PASSWORD="pluma"
POSTGRES_DB="pluma"
POSTGRES_PORT="5432"
# Host port mapped to the Vite dev server inside the dev compose stack.
WEBAPP_PORT="5173"

# The Root account is auto-provisioned from this email + ROOT_PASSWORD at server
# startup (enabled and verified). A signup that matches ROOT_EMAIL also becomes
# Role.Root. Either way the account exists without manual DB work.
ROOT_EMAIL="root@pluma.local"

# Initial password for the auto-provisioned Root account. The account is created
# with this password but flagged to require a change on first login, so it is
# only ever a bootstrap credential — set something unguessable and rotate it the
# moment you sign in. If a Root account already exists this value is ignored
# (an existing password is never overwritten).
ROOT_PASSWORD="change-me-on-first-login"

# HS256 signing secret for auth JWTs. Rotate to invalidate all live tokens.
# Must be at least 32 characters in production.
JWT_SECRET="dev-insecure-change-me-in-production-at-least-32-chars"

# Public origin used as the WebAuthn Relying Party origin. REQUIRED in production
# — passkey registration silently fails if unset. Must match the browser-visible
# scheme + host + port (no trailing slash). PUBLIC_ORIGIN takes precedence.
ORIGIN="http://localhost:5173"

# Production listen port for the SvelteKit adapter-node server (the standalone
# Dockerfile image). Defaults to 3000 if unset.
PORT="3000"

# Override the catalogue scrape source for `pnpm db:seed`. Defaults to the
# canonical FIU mirror; point at a staging copy when testing seed changes.
PLUMA_BASE_URL="https://biorg.cs.fiu.edu/pluma"
