// PluMA Online (Svelte) — Postgres datasource.
// See src/lib/server/db.ts for the Prisma client singleton.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // native: matches whoever runs `prisma generate` locally.
  // linux-musl-openssl-3.0.x: alpine-based production/dev images.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ──────────────────────────────────────────────────────────────────────
// Plugin catalog
// ──────────────────────────────────────────────────────────────────────

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  plugins Plugin[]
}

model Language {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  plugins Plugin[]
}

model Plugin {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  githubUrl   String
  rating      Int     @default(0)
  verified    Boolean @default(true)
  tags        String  @default("")

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  languageId Int
  language   Language @relation(fields: [languageId], references: [id])

  authorId Int?
  author   User? @relation("AuthoredPlugins", fields: [authorId], references: [id])

  pipelines  PipelinePlugin[]
  editEvents PluginEditEvent[]
  edgesFrom  PluginEdge[]      @relation("PluginEdgeFrom")
  edgesTo    PluginEdge[]      @relation("PluginEdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([languageId])
  @@index([authorId])
}

// ──────────────────────────────────────────────────────────────────────
// Pipelines
// ──────────────────────────────────────────────────────────────────────

enum PipelineStatus {
  Completed
  InProgress
  Future
}

model Pipeline {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String
  githubUrl   String         @unique
  status      PipelineStatus @default(Completed)
  rating      Int            @default(0)

  authorId Int?
  author   User? @relation("AuthoredPipelines", fields: [authorId], references: [id])

  plugins PipelinePlugin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}

// ──────────────────────────────────────────────────────────────────────
// Plugin recommendations
// ──────────────────────────────────────────────────────────────────────

model PipelinePlugin {
  pipelineId Int
  pluginId   Int
  position   Int

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  plugin   Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@id([pipelineId, position])
  @@index([pluginId])
}

model PluginEditEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  pluginId  Int
  userId    Int?
  createdAt DateTime @default(now())

  plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

// Directed co-occurrence aggregate: weight is incremented whenever
// `from` is observed earlier than `to` in the same pipeline or session.
model PluginEdge {
  fromPluginId Int
  toPluginId   Int
  weight       Int      @default(0)
  updatedAt    DateTime @updatedAt

  from Plugin @relation("PluginEdgeFrom", fields: [fromPluginId], references: [id], onDelete: Cascade)
  to   Plugin @relation("PluginEdgeTo", fields: [toPluginId], references: [id], onDelete: Cascade)

  @@id([fromPluginId, toPluginId])
  @@index([fromPluginId, weight])
  @@index([toPluginId, weight])
}

// ──────────────────────────────────────────────────────────────────────
// README cache
//
// Independent of Plugin/Pipeline rows (no FK back) so renames or
// deletions don't cascade. Rows are upserted by readme.ts and pruned
// out-of-band if their owner disappears.
// ──────────────────────────────────────────────────────────────────────

enum ReadmeOwner {
  Plugin
  Pipeline
}

model ReadmeCache {
  ownerType     ReadmeOwner
  ownerId       Int
  html          String?
  etag          String?
  // Cached repo default branch (looked up via /repos/{owner}/{repo}).
  // Used by sanitize-html transformTags to rewrite relative links.
  defaultBranch String?
  // Last GitHub response status (200, 304, 404, 403, 0 for network error).
  lastStatus    Int
  fetchedAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@id([ownerType, ownerId])
  @@index([fetchedAt])
}

// ──────────────────────────────────────────────────────────────────────
// Identity & authorship
// ──────────────────────────────────────────────────────────────────────

enum Role {
  Root
  Admin
  User
  Guest
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  // argon2id hash; never returned to clients.
  passwordHash String
  displayName  String? @unique
  website      String?
  institution  String?
  avatar       String?
  role         Role    @default(User)
  // enabled=true means the account has been verified and may sign in.
  enabled      Boolean @default(false)

  verifiedAt    DateTime?
  verifiedById  Int?
  verifiedBy    User?     @relation("UserVerification", fields: [verifiedById], references: [id])
  verifiedUsers User[]    @relation("UserVerification")

  // Profile page linkage (faculty/contributor entries can be authored by a user).
  person   Person? @relation(fields: [personId], references: [id])
  personId Int?    @unique

  plugins   Plugin[]   @relation("AuthoredPlugins")
  pipelines Pipeline[] @relation("AuthoredPipelines")

  passkeys Passkey[]

  // Bumped whenever the user is disabled/re-verified/promoted so outstanding JWTs
  // become invalid on next verify without needing a server-side session store.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────
// WebAuthn / Passkeys
// ──────────────────────────────────────────────────────────────────────

model Passkey {
  // Base64url-encoded credential ID from the authenticator.
  id         String  @id
  // Base64url-encoded public key bytes (COSE).
  publicKey  String
  counter    BigInt  @default(0)
  // "singleDevice" or "multiDevice"
  deviceType String
  backedUp   Boolean @default(false)
  // COSE algorithm identifier (e.g. -7 for ES256, -257 for RS256).
  algorithm  Int
  // Authenticator transports the credential supports.
  transports String  @default("[]")
  // Human-friendly label set by the user.
  label      String  @default("Passkey")

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id        Int      @id @default(autoincrement())
  challenge String   @unique
  userId    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum PersonKind {
  Faculty
  Student
  Contributor
  Alumni
}

model Person {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  role      String
  kind      PersonKind @default(Contributor)
  // JSON-encoded [{ label, href }]
  linksJson String     @default("[]")
  sortOrder Int        @default(0)

  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────
// Publications
// ──────────────────────────────────────────────────────────────────────

model Publication {
  id      Int     @id @default(autoincrement())
  authors String
  year    Int
  title   String  @unique
  venue   String
  volume  Int?
  issue   Int?
  pages   String?
  doi     String?
  url     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}
