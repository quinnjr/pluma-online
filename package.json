{
	"name": "pluma-online-new",
	"private": true,
	"version": "2.2.0",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' ; husky || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:status": "prisma migrate status",
		"db:seed": "prisma db seed",
		"db:reset": "prisma migrate reset --force",
		"db:studio": "prisma studio"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.3",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"husky": "^9.1.7",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.9",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@casl/ability": "^6.8.0",
		"@fontsource-variable/crimson-pro": "^5.2.8",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@prisma/client": "^6.19.3",
		"@simplewebauthn/browser": "^13.2.4",
		"@simplewebauthn/server": "^13.3.2",
		"argon2": "^0.44.0",
		"cheerio": "^1.1.4",
		"dotenv": "^17.4.2",
		"jose": "^6.2.2",
		"prisma": "^6.19.3",
		"tsx": "^4.21.0"
	}
}
